{
  "name": "outrigger-birchstreet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "start": "pnpm prepare:expo && expo start",
    "android": "pnpm prepare:expo && expo start --android",
    "web:build": "vite build",
    "web:embed": "node scripts/embed-web-app.mjs",
    "prepare:expo": "pnpm web:build && pnpm web:embed",
    "build": "pnpm prepare:expo && expo export --platform android --output-dir expo-dist",
    "doctor": "expo-doctor",
    "eas-build-post-install": "pnpm prepare:expo",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^6.0.0",
    "expo-doctor": "^1.21.8",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
